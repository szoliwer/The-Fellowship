          "author": {
            "role": "assistant",
            "name": null,
            "metadata": {}
          },
          "create_time": 1789301460.0,
          "update_time": null,
          "content": {
            "content_type": "text",
            "parts": [
              "Some variation is expected. It matters most if the differences change your conclusions. Measure it before deciding: run each paper several times and check how often the extracted items agree."
            ]
          },
          "status": "finished_successfully",
          "end_turn": true,
          "weight": 1.0,
