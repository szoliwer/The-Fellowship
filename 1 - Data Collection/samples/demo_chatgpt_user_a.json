          "update_time": null,
          "content": {
            "content_type": "text",
            "parts": [
              "We're using an LLM to pull variant-phenotype mentions out of papers for a literature review. Running the same paper twice gives slightly different lists. How worried should I be about reproducibility?"
            ]
          },
          "status": "finished_successfully",
          "end_turn": null,
          "weight": 1.0,
          "metadata": {},
          "recipient": "all"
        },
