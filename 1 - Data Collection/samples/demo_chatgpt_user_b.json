      "b_s02-sys": {
        "id": "b_s02-sys",
        "message": {
          "id": "b_s02-sys",
          "author": {
            "role": "system",
            "name": null,
            "metadata": {}
          },
          "create_time": null,
          "update_time": null,
          "content": {
